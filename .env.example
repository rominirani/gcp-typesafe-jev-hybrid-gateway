# ==============================================================================
# Google Cloud Gemini Enterprise Agent Platform & TypeSafe Jev Configuration
# ==============================================================================

# GCP Agent Platform Settings
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# TypeSafe AI Jev Settings
# Obtain your API key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=ts_live_xxxxxxxxxxxxxxxxxxxx
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest

# Routing Policy
# Decisions with confidence >= CONFIDENCE_THRESHOLD are fast-routed to Jev System 1 reflexes.
# Decisions below this threshold or flagged with ambiguous intent escalate to Gemini on Agent Platform.
CONFIDENCE_THRESHOLD=0.90

# Optional BigQuery Telemetry Sink
ENABLE_BIGQUERY_TELEMETRY=false
BIGQUERY_DATASET=ai_gateway_telemetry
BIGQUERY_TABLE=gateway_metrics

# Server Settings
HOST=0.0.0.0
PORT=8080
